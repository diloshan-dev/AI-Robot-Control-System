# Copy to .env and fill with your real values. Never commit .env.
# All API services support up to 10 keys, provided as comma-separated values.
# Requests are distributed in a round-robin order; on rate-limit/auth failures,
# the failing key is skipped and the next key is tried automatically.

# Gemini multi-key pool (supports 1-10 keys)
GEMINI_API_KEYS=key_1_here,key_2_here,key_3_here

# ElevenLabs multi-key pool (supports 1-10 keys)
ELEVENLABS_API_KEYS=key_1_here,key_2_here,key_3_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# OpenAI Whisper multi-key pool (supports 1-10 keys)
OPENAI_API_KEYS=key_1_here,key_2_here,key_3_here

# Optional runtime config
ROBOT_SERVER_HOST=0.0.0.0
ROBOT_SERVER_PORT=8000
LOG_LEVEL=INFO
