# Copy to .env and fill with your real values. Never commit .env.

# Multi-key Gemini rotation (comma-separated list is supported)
GEMINI_API_KEYS=your_first_key,another_key_if_needed

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id

# STT provider: OpenAI Whisper API
OPENAI_API_KEY=your_openai_api_key

# Optional defaults for runtime
ROBOT_SERVER_HOST=192.168.1.50
ROBOT_SERVER_PORT=8000
LOG_LEVEL=INFO
