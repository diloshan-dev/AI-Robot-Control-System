menu "Kaniye Robot Settings"

    config ROBOT_WIFI_SSID
        string "WiFi SSID"
        default "your_wifi_ssid"

    config ROBOT_WIFI_PASSWORD
        string "WiFi Password"
        default "your_wifi_password"

    config ROBOT_SERVER_HOST
        string "Robot server host"
        default "192.168.1.50"

    config ROBOT_SERVER_PORT
        int "Robot server port"
        range 1 65535
        default 8000

    config ROBOT_AUDIO_DMA_BUF_LEN
        int "Audio DMA buffer length (smaller is lower latency)"
        range 64 1024
        default 256

    config ROBOT_AUDIO_SELF_MONITOR
        bool "Include remote microphone in local monitor mix"
        default n

endmenu
